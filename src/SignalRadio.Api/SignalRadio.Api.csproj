<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.27.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.27.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.13" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!-- Copy agent prompt files (Agents/**/PROMPT.md) to the output directory. -->
  <ItemGroup>
    <None Include="Agents\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignalRadio.Core\SignalRadio.Core.csproj" />
    <ProjectReference Include="..\SignalRadio.Data\SignalRadio.Data.csproj" />
    <ProjectReference Include="..\SignalRadio.Simulator\SignalRadio.Simulator.csproj" />
  </ItemGroup>

</Project>
