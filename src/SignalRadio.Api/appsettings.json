{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Features": {
    "Asr": true,
    "Embeddings": true,
    "Summaries": false
  },
  "Pipeline": {
    "RecentBatchSize": 5,
    "RecentLookbackMinutes": 10,
    "BackfillBatchSize": 10,
    "BackfillLookbackHours": 72,
    "MaxConcurrent": 2,
    "PollIntervalSeconds": 5,
    "BackfillPollIntervalSeconds": 30
  },
  "Summaries": {
    "WindowMinutes": 30,
    "MinTranscripts": 5,
    "MaxTranscriptsPerRun": 50,
    "PollIntervalSeconds": 60
  },
  "Agents": {
    "PromptPath": "Agents"
  },
  "TalkGroups": {
    "CsvPath": "config/danecom-talkgroups.csv"
  }
}
